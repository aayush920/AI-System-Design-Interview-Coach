│
├── repository
│   ├── InterviewSessionRepository
│   ├── QuestionAnswerRepository
│   └── EvaluationRepository
│
├── service
│   ├── InterviewService
│   └── GeminiService
│
└── AiSystemDesignCoachBackendApplication
```

